# =============================================================
# PowerBook - pb_inc/.htaccess
# =============================================================
# Default: Alles in pb_inc/ ist Include-Code und darf nicht
# direkt per HTTP geladen werden.
# Unterordner (admincenter/, smilies/) überschreiben diese
# Regel über ihre eigene .htaccess.
# Die öffentlichen Hilfeseiten (smilies-help.html,
# text-help.html) werden hier ausdrücklich erlaubt.
# =============================================================

# Default: alles blockieren
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Hilfeseiten zu Smileys und Formatierung (seit 3.1 steht dieselbe Hilfe
# ausklappbar im Formular; die Seiten bleiben für alte Links erreichbar)
<FilesMatch "^(smilies-help|text-help)\.html$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
