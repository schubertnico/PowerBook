<?php

/**
 * PowerBook - PHP Guestbook System
 * Vorlage für den Datenbankzugang
 *
 * Normalerweise legt install.php die Datei pb_inc/mysql.inc.php selbst an.
 * Nur wenn der Installer sie nicht schreiben darf: diese Vorlage als
 * pb_inc/mysql.inc.php speichern, die Werte vom Hoster eintragen und
 * per FTP hochladen.
