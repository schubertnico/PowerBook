declare(strict_types=1);

$config_sql_server = 'localhost';       // Datenbankserver (beim Hoster oft nicht localhost)
$config_sql_port = 3306;                // Port, fast immer 3306
$config_sql_user = '';                  // Benutzername
$config_sql_password = '';              // Passwort
$config_sql_database = '';              // Name der Datenbank

// Tabellennamen (nur ändern, wenn eine ältere Installation andere Namen nutzt)
$pb_config = 'pb_config';
$pb_admin = 'pb_admins';
$pb_entries = 'pb_entries';
