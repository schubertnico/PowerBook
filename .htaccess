# =============================================================
# PowerBook - Root .htaccess
# =============================================================
# Schützt das öffentliche Web-Root vor unerwünschten Zugriffen.
# Greift nur, wenn AllowOverride im Apache-VirtualHost auf
# "All" bzw. "FileInfo Indexes Limit AuthConfig" steht.
# Im PowerBook-Docker-Setup ist das automatisch der Fall.
# Auf Shared-Hosting (PlusServer, Strato, Hetzner Webhosting,
# IONOS etc.) ist .htaccess standardmäßig aktiv.
# =============================================================


# -------------------------------------------------------------
# Default-Verhalten
# -------------------------------------------------------------

# Verzeichnis-Listings deaktivieren (verhindert Information-Leak)
Options -Indexes -MultiViews +FollowSymLinks

# Apache-Signatur in Fehlerseiten unterdrücken
ServerSignature Off

# UTF-8 als Default-Charset
AddDefaultCharset UTF-8


# -------------------------------------------------------------
# Security Headers
# -------------------------------------------------------------
<IfModule mod_headers.c>
    # Verhindere MIME-Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking-Schutz (nur eigene Domain darf einbetten)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referer nur an gleiche Origin senden
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Browser-Features deaktivieren, die wir nicht brauchen
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Cross-Origin-Isolation
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Server-Header bereinigen
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server

    # HSTS — nur aktivieren, wenn das Projekt durchgängig per HTTPS
    # ausgeliefert wird. Default auskommentiert.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>


# -------------------------------------------------------------
# HTTP-Methoden einschränken
# Nur GET, POST, HEAD sind sinnvoll — alle anderen blocken.
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)$
    RewriteRule .* - [F,L]
</IfModule>


# -------------------------------------------------------------
# Versteckte Dateien (.git, .env, .htaccess, .DS_Store, ...) blocken
# -------------------------------------------------------------
RedirectMatch 403 (?i)/\.(?!well-known/)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# -------------------------------------------------------------
# Verzeichnisse, die nicht öffentlich erreichbar sein sollen
# (auch falls sie versehentlich auf den Live-Server kommen)
# -------------------------------------------------------------
RedirectMatch 403 (?i)^/vendor(/.*)?$
RedirectMatch 403 (?i)^/tests(/.*)?$
RedirectMatch 403 (?i)^/docs(/.*)?$
RedirectMatch 403 (?i)^/coverage(-html|-report)?(/.*)?$
RedirectMatch 403 (?i)^/hooks(/.*)?$
RedirectMatch 403 (?i)^/todos(/.*)?$
RedirectMatch 403 (?i)^/logs(/.*)?$
RedirectMatch 403 (?i)^/node_modules(/.*)?$
RedirectMatch 403 (?i)^/rector-output(/.*)?$
RedirectMatch 403 (?i)^/uploads(/.*)?$
RedirectMatch 403 (?i)^/var/(cache|log)(/.*)?$


# -------------------------------------------------------------
# Sensitive Dateiendungen / Dateien blocken
# -------------------------------------------------------------
<FilesMatch "(?i)\.(md|markdown|lock|cache|sql|log|dist|example|sample|ini|yml|yaml|neon|json|toml|bak|backup|old|orig|swp|swo|tmp|temp|inc|sublime-(workspace|project)|code-workspace|psd|ai|sketch|fig)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Spezifische Tool-Configs / Build-Files blocken
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|bower\.json|gulpfile\.js|gruntfile\.js|webpack\.config\.js|vite\.config\.(js|ts)|rollup\.config\.(js|ts)|tsconfig\.json|phpunit\.xml(\.dist)?|phpstan\.neon(\.dist)?|phpmd\.xml|psalm\.xml(\.dist)?|rector\.php|\.php-cs-fixer(\.dist)?\.php|coverage\.xml|coverage_report\.php|Dockerfile|docker-compose\.ya?ml|Makefile|Procfile|\.editorconfig|\.babelrc|\.eslintrc.*|\.prettierrc.*|\.stylelintrc.*|\.npmrc|\.nvmrc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# -------------------------------------------------------------
# pb_inc/admincenter/.htaccess übernimmt die Feinabstimmung für
# die include-Dateien dort. Hier auf Root-Level NUR sicherstellen,
# dass *.inc.php (z.B. pb_inc/*.inc.php) nicht direkt aufrufbar ist.
# -------------------------------------------------------------
<FilesMatch "(?i)\.inc\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# -------------------------------------------------------------
# Installer nach der Installation sperren
# -------------------------------------------------------------
# install.php liefert selbst HTTP 403, sobald install.lock (bzw.
# .installed aus PowerBook 3.0) existiert. Die Regel sperrt die Datei
# zusätzlich, bevor PHP sie überhaupt ausführt. Ausnahme: die
# Abschlussseite (step=4) direkt nach der Installation – install.lock
# entsteht schon vorher, und PHP zeigt Schritt 4 nur in der Sitzung,
# die gerade installiert hat. Die Sperrdatei wird im Ordner von
# install.php gesucht, damit die Regel auch in einem Unterordner greift.
# update.php bleibt erreichbar (Anmeldung als Administrator nötig).
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} !(^|&)step=4(&|$)
    RewriteCond %{REQUEST_FILENAME} ^(.+/)install\.php$
    RewriteCond %1install.lock -f
    RewriteRule ^install\.php$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} ^(.+/)install\.php$
    RewriteCond %1.installed -f
    RewriteRule ^install\.php$ - [F,L]
</IfModule>

# Alter Installer bis PowerBook 3.0: Seit 3.1 nur noch ein Platzhalter,
# der auf install.php weiterleitet. Gesperrt, falls beim Aktualisieren
# nur geänderte Dateien hochgeladen wurden und der alte noch da ist.
<Files "install_deu.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>


# -------------------------------------------------------------
# Caching für statische Assets (Performance)
# -------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# -------------------------------------------------------------
# Deutsche Fehlerseiten
# -------------------------------------------------------------
# Als Text statt als Datei, damit sie auch greifen, wenn PowerBook in
# einem Unterordner liegt (ErrorDocument mit Pfad zählt ab der Wurzel
# der Domain). Der Server-Kopf mit Versionsnummer lässt sich nur in der
# Serverkonfiguration abschalten (ServerTokens Prod), nicht hier.
# Umlaute als HTML-Entitäten: Apache schickt eigene Fehlerseiten immer
# mit charset=iso-8859-1, die Angabe im meta-Element zählt dann nicht.
ErrorDocument 403 "<!DOCTYPE html><html lang='de'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Zugriff verweigert</title></head><body style='font-family:system-ui,sans-serif;max-width:40rem;margin:3rem auto;padding:0 1rem'><h1>Zugriff verweigert</h1><p>Diese Datei oder dieses Verzeichnis ist nicht &ouml;ffentlich zug&auml;nglich.</p><p><a href='/'>Zur Startseite</a></p></body></html>"
ErrorDocument 404 "<!DOCTYPE html><html lang='de'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Seite nicht gefunden</title></head><body style='font-family:system-ui,sans-serif;max-width:40rem;margin:3rem auto;padding:0 1rem'><h1>Seite nicht gefunden</h1><p>Die aufgerufene Adresse gibt es hier nicht. Bitte pr&uuml;fen Sie die Schreibweise.</p><p><a href='/'>Zur Startseite</a></p></body></html>"


# -------------------------------------------------------------
# PHP-Hardening (greift nur, wenn mod_php geladen)
# -------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
    php_flag expose_php Off
    php_flag session.cookie_httponly On
    # session.cookie_secure wird nicht mehr fest abgeschaltet: PowerBook
    # setzt Secure selbst, sobald die Seite per HTTPS aufgerufen wird.
    # SameSite=Lax: Links aus Mails (z. B. zum AdminCenter) behalten die
    # Anmeldung, Formulare von fremden Seiten schicken das Cookie nicht mit.
    php_value session.cookie_samesite "Lax"
    php_flag session.use_only_cookies On
    php_value upload_max_filesize "2M"
    php_value post_max_size "4M"
</IfModule>
